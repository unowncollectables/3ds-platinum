+           case DRAW_CMD_G3_NORMAL:seen|=2;deps|=G3DEP_LIGHT|G3DEP_TEXCOORD;break;
            case DRAW_CMD_G3_BEGIN:seen|=8;break;
            case DRAW_CMD_G3_VTX:case DRAW_CMD_G3_VTX16:case DRAW_CMD_G3_VTX10:
