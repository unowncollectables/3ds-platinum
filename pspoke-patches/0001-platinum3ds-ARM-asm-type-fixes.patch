From 7ca6bd0431592031d57eea217d389177828ddbf1 Mon Sep 17 00:00:00 2001
From: platinum3ds <local@box>
Date: Fri, 16 Oct 2026 12:23:21 -0400
Subject: [PATCH 01/11] platinum3ds: ARM asm/type fixes

---
 port/native-audio-app/stackprobe.c                     | 2 +-
 port/native-audio-sound/os_sync.c                      | 2 +-
 port/native-graphics/alias-proof/generate_registers.py | 4 ++--
 port/native-probe/backing/generate.py                  | 6 +++---
 port/native-probe/backing/generate_registers.py        | 4 ++--
 port/native-sound-audio/os_sync.c                      | 2 +-
 6 files changed, 10 insertions(+), 10 deletions(-)

diff --git a/port/native-audio-app/stackprobe.c b/port/native-audio-app/stackprobe.c
index 323e3c3..44987e7 100644
--- a/port/native-audio-app/stackprobe.c
+++ b/port/native-audio-app/stackprobe.c
@@ -20,7 +20,7 @@ void PSPNativeStackProbeInit(void)
     memset(&info, 0, sizeof info);
     info.size = sizeof info;
     int rc = sceKernelReferThreadStatus(sceKernelGetThreadId(), &info);
-    unsigned sp0; asm volatile("move %0, $sp" : "=r"(sp0));
+    unsigned sp0; sp0 = (unsigned)(uintptr_t)__builtin_frame_address(0);
     PSPNativeMemLog("[STACK] refer rc=%d stack=%p size=%u sp=%08x", rc, info.stack, (unsigned)info.stackSize, sp0);
     if (rc < 0) return;
     stackBase = (unsigned)(uintptr_t)info.stack;
diff --git a/port/native-audio-sound/os_sync.c b/port/native-audio-sound/os_sync.c
index 44379f0..b2628d0 100644
--- a/port/native-audio-sound/os_sync.c
+++ b/port/native-audio-sound/os_sync.c
@@ -24,7 +24,7 @@ void DC_FlushRange(const void*p,u32 n){if(n)sceKernelDcacheWritebackInvalidateRa
 void DC_StoreRange(const void*p,u32 n){if(n)sceKernelDcacheWritebackRange(p,n);}
 void DC_InvalidateRange(void*p,u32 n){if(n)sceKernelDcacheInvalidateRange(p,n);}
 void DC_FlushAll(void){sceKernelDcacheWritebackInvalidateAll();}
-void DC_WaitWriteBufferEmpty(void){__asm__ volatile("sync":: :"memory");}
+void DC_WaitWriteBufferEmpty(void){__sync_synchronize();}
 // This flag means the Nitro emulator's private 0x04FFF200 interface, which PSP lacks.
 BOOL OS_IsRunOnEmulator(void){return FALSE;}
 // Yield instead of burning host cycles; sound command completion must be serviced
diff --git a/port/native-graphics/alias-proof/generate_registers.py b/port/native-graphics/alias-proof/generate_registers.py
index a93891f..c21a4a4 100644
--- a/port/native-graphics/alias-proof/generate_registers.py
+++ b/port/native-graphics/alias-proof/generate_registers.py
@@ -17,8 +17,8 @@ for family in ['G2','G2S','G3','G3X','GX','GXS']:
  assert found==set(decl), (family, set(decl)-found)
 rows=sorted(set(rows),key=lambda r:(r[1],r[0]))
 size=(max(o+w for _,o,w,_ in rows)+63)&~63
-s=['/* Generated from libntr X86 ioreg headers; offsets verified against ARM9. */','.section .bss','.balign 64','.global PSPNative_GfxRegisters','.type PSPNative_GfxRegisters, @object','PSPNative_GfxRegisters:',f'.space {size}',f'.size PSPNative_GfxRegisters, {size}']
-for name,off,width,_ in rows:s += [f'.global {name}',f'.type {name}, @object',f'.set {name}, PSPNative_GfxRegisters + {off}',f'.size {name}, {width}']
+s=['/* Generated from libntr X86 ioreg headers; offsets verified against ARM9. */','.section .bss','.balign 64','.global PSPNative_GfxRegisters','.type PSPNative_GfxRegisters, %object','PSPNative_GfxRegisters:',f'.space {size}',f'.size PSPNative_GfxRegisters, {size}']
+for name,off,width,_ in rows:s += [f'.global {name}',f'.type {name}, %object',f'.set {name}, PSPNative_GfxRegisters + {off}',f'.size {name}, {width}']
 (p/'graphics_registers.S').write_text('\n'.join(s)+'\n')
 (p/'registers.json').write_text(json.dumps(rows,indent=2)+'\n')
 print(f'{len(rows)} graphics symbols share {size} bytes')
diff --git a/port/native-probe/backing/generate.py b/port/native-probe/backing/generate.py
index 6dd5147..d9ea1ee 100644
--- a/port/native-probe/backing/generate.py
+++ b/port/native-probe/backing/generate.py
@@ -14,8 +14,8 @@ s=re.sub(r'^u8 s_HW_MAIN_MEM_EX\[[^\]]+\];','',s,flags=re.M)
 # Ensure base memory buffers and OSArenaInfo have at least cache-line alignment.
 s=re.sub(r'^(u8 s_HW_\w+\[[^\]]+\]);',r'\1 __attribute__((aligned(64)));',s,flags=re.M)
 (b/'storage.c').write_text('/* Generated from actual libntr simvariables.h; see README. */\n#include <nitro.h>\n'+s+'\nGXVRamTex s_SIM_GXVRamTex;\nGXVRamTexPltt s_SIM_GXVRamTexPltt;\nGXVRamBGExtPltt s_SIM_GXBgExtPltt;\nGXVRamSubBGExtPltt s_SIM_GXSubBgExtPltt;\n')
-asm=['.section .bss','.balign 64','.global PSPNative_PaletteRAM','.type PSPNative_PaletteRAM,@object','PSPNative_PaletteRAM:']
+asm=['.section .bss','.balign 64','.global PSPNative_PaletteRAM','.type PSPNative_PaletteRAM,%object','PSPNative_PaletteRAM:']
 for name in ['s_HW_BG_PLTT','s_HW_OBJ_PLTT','s_HW_DB_BG_PLTT','s_HW_DB_OBJ_PLTT']:
- asm += ['.global '+name,'.type '+name+',@object',name+':','.space 512','.size '+name+',512']
-asm += ['.size PSPNative_PaletteRAM,2048','.balign 64','.global SDK_AUTOLOAD_DTCM_START','.type SDK_AUTOLOAD_DTCM_START,@object','SDK_AUTOLOAD_DTCM_START:','.space 16384','.size SDK_AUTOLOAD_DTCM_START,16384']
+ asm += ['.global '+name,'.type '+name+',%object',name+':','.space 512','.size '+name+',512']
+asm += ['.size PSPNative_PaletteRAM,2048','.balign 64','.global SDK_AUTOLOAD_DTCM_START','.type SDK_AUTOLOAD_DTCM_START,%object','SDK_AUTOLOAD_DTCM_START:','.space 16384','.size SDK_AUTOLOAD_DTCM_START,16384']
 (b/'memory_layout.S').write_text('\n'.join(asm)+'\n')
diff --git a/port/native-probe/backing/generate_registers.py b/port/native-probe/backing/generate_registers.py
index 0c15b04..44d05da 100644
--- a/port/native-probe/backing/generate_registers.py
+++ b/port/native-probe/backing/generate_registers.py
@@ -18,8 +18,8 @@ for family in ['CP','MI','OS','PAD','PXI','SND','SPI']:
  size=0
  for j,cluster in enumerate(clusters):
   base=min(x[1] for x in cluster)&~63;extent=(max(o+w for _,o,w,_ in cluster)-base+63)&~63;size+=extent;symbol='PSPNative_'+family+'Registers'+str(j)
-  asm+=['.balign 64','.global '+symbol,'.type '+symbol+',@object',symbol+':',f'.space {extent}',f'.size {symbol},{extent}']
-  for name,off,width,_ in cluster:asm += [f'.global {name}',f'.type {name},@object',f'.set {name},{symbol}+{off-base}',f'.size {name},{width}'];allnames.add(name)
+  asm+=['.balign 64','.global '+symbol,'.type '+symbol+',%object',symbol+':',f'.space {extent}',f'.size {symbol},{extent}']
+  for name,off,width,_ in cluster:asm += [f'.global {name}',f'.type {name},%object',f'.set {name},{symbol}+{off-base}',f'.size {name},{width}'];allnames.add(name)
  rows+=subset
  out=p/'include/nitro/hw/X86'/path.name;out.parent.mkdir(parents=True,exist_ok=True);s,n=re.subn(r'(#define\s+REG_\w+_ADDR\s+)\(&?(s_reg_\w+)\)',r'\1((u64)(uintptr_t)&\2)',s);out.write_text('#include <stdint.h>\n'+s)
  print(family,len(subset),size)
diff --git a/port/native-sound-audio/os_sync.c b/port/native-sound-audio/os_sync.c
index 44379f0..b2628d0 100644
--- a/port/native-sound-audio/os_sync.c
+++ b/port/native-sound-audio/os_sync.c
@@ -24,7 +24,7 @@ void DC_FlushRange(const void*p,u32 n){if(n)sceKernelDcacheWritebackInvalidateRa
 void DC_StoreRange(const void*p,u32 n){if(n)sceKernelDcacheWritebackRange(p,n);}
 void DC_InvalidateRange(void*p,u32 n){if(n)sceKernelDcacheInvalidateRange(p,n);}
 void DC_FlushAll(void){sceKernelDcacheWritebackInvalidateAll();}
-void DC_WaitWriteBufferEmpty(void){__asm__ volatile("sync":: :"memory");}
+void DC_WaitWriteBufferEmpty(void){__sync_synchronize();}
 // This flag means the Nitro emulator's private 0x04FFF200 interface, which PSP lacks.
 BOOL OS_IsRunOnEmulator(void){return FALSE;}
 // Yield instead of burning host cycles; sound command completion must be serviced
-- 
2.47.3

