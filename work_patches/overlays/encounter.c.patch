+/* platinum3ds run 118 catch_swap (Play "Swap catch into party", default 0; the reference port pokeplatinum-3ds 0042).
+ * A Pokemon caught with the party full: before the nickname the battle asks "Your party is full. Add X to your party?";
+ * YES opens the battle's party screen (SHIFT reads SEND TO PC) to pick who goes to the PC instead (not one holding Mail or
+ * with a Ball Capsule). The battle stores the caught one in the PC as ever and notes where; once the battle's party is back
+ * in the save (UpdateFieldSystemFromDTO) the two change places. Not in the Safari Zone, Pal Park or the catching tutorial.
+ * Off: the game's code paths are unchanged. No save format change: a Pokemon moves between the party and a PC slot. */
+static struct { int boxID, pos, slot, picking; u32 personality; } sP3dsSwap = { -1, 0, -1, 0, 0 };
+void P3DS_CatchSwapReset(void) { sP3dsSwap.boxID = -1; sP3dsSwap.slot = -1; sP3dsSwap.picking = 0; }
+void P3DS_CatchSwapToPC(int boxID, int pos, u32 personality) { sP3dsSwap.boxID = boxID; sP3dsSwap.pos = pos; sP3dsSwap.personality = personality; }
+void P3DS_CatchSwapSetPick(int slot) { sP3dsSwap.slot = slot; }
+int P3DS_CatchSwapPick(void) { return sP3dsSwap.slot; }
+void P3DS_CatchSwapSetPicking(int on) { sP3dsSwap.picking = on; }
+int P3DS_CatchSwapPicking(void) { return sP3dsSwap.picking; }
+int P3DS_CatchSwapCanGoToPC(Pokemon *mon)
+{
+    return !Item_IsMail(Pokemon_GetValue(mon, MON_DATA_HELD_ITEM, NULL)) && Pokemon_GetValue(mon, MON_DATA_BALL_CAPSULE_ID, NULL) == 0;
+}
+static void P3DS_CatchSwapApply(FieldSystem *fieldSystem)
+{
+    Party *party = SaveData_GetParty(fieldSystem->saveData);
+    PCBoxes *pcBoxes = SaveData_GetPCBoxes(fieldSystem->saveData);
+
+    if (sP3dsSwap.boxID >= 0 && sP3dsSwap.boxID < MAX_PC_BOXES && sP3dsSwap.pos >= 0 && sP3dsSwap.pos < MAX_MONS_PER_BOX
+        && sP3dsSwap.slot >= 0 && sP3dsSwap.slot < Party_GetCurrentCount(party)) {
+        BoxPokemon *caught = PCBoxes_GetBoxMonAt(pcBoxes, sP3dsSwap.boxID, sP3dsSwap.pos);
+        Pokemon *partyMon = Party_GetPokemonBySlotIndex(party, sP3dsSwap.slot);
+
+        if (BoxPokemon_GetValue(caught, MON_DATA_SPECIES, NULL) != SPECIES_NONE
+            && BoxPokemon_GetValue(caught, MON_DATA_PERSONALITY, NULL) == sP3dsSwap.personality
+            && P3DS_CatchSwapCanGoToPC(partyMon)) {
+            Pokemon *newMon = Pokemon_New(HEAP_ID_FIELD2);
+
+            Pokemon_FromBoxPokemon(caught, newMon);
+            PCBoxes_InitBoxMonAt(pcBoxes, sP3dsSwap.boxID, sP3dsSwap.pos);
+            PCBoxes_TryStoreBoxMonAt(pcBoxes, sP3dsSwap.boxID, sP3dsSwap.pos, Pokemon_GetBoxPokemon(partyMon));
+            Party_AddPokemonBySlotIndex(party, sP3dsSwap.slot, newMon);
+            SaveData_SetFullSaveRequired();
+            Heap_Free(newMon);
+        }
+    }
+
+    P3DS_CatchSwapReset();
+}
