+static void P3DS_Letters(String *string, const char *t)
+{
+    for (; *t; t++) {
+        const char c = *t;
+        if (c >= 'A' && c <= 'Z') String_AppendChar(string, 0x12B + (c - 'A'));
+        else if (c >= 'a' && c <= 'z') String_AppendChar(string, 0x145 + (c - 'a'));
+        else if (c >= '0' && c <= '9') String_AppendChar(string, 0x121 + (c - '0'));
+        else if (c == ' ') String_AppendChar(string, 0x1DE);
+        else if (c == '.') String_AppendChar(string, 0x1AE);
+        else if (c == '!') String_AppendChar(string, 0x1AB);
+        else if (c == '?') String_AppendChar(string, 0x1AC);
+        else if (c == ',') String_AppendChar(string, 0x1AD);
+        else if (c == '\'') String_AppendChar(string, 0x1B3);
+        else if (c == '\n') String_AppendChar(string, 0xE000);
+    }
+}
+static u8 P3DS_SwapPrint(BattleSystem *battleSys, Pokemon *caught, Pokemon *picked, int what)
+{
+    String *string = String_Init(160, HEAP_ID_BATTLE), *name = String_Init(32, HEAP_ID_BATTLE);
+    u8 printerID;
+
+    if (what == 0) {
+        P3DS_Letters(string, "Your party is full.\nAdd "); Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name); String_Concat(string, name);
+        P3DS_Letters(string, " to your party?");
+    } else if (what == 1) {
+        Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name); String_Concat(string, name);
+        P3DS_Letters(string, Item_IsMail(Pokemon_GetValue(picked, MON_DATA_HELD_ITEM, NULL)) ? " is holding Mail.\nIt can't be sent to the PC." : " has a Ball Capsule.\nIt can't be sent to the PC.");
+    } else {
+        Pokemon_GetValue(caught, MON_DATA_NICKNAME_STRING, name); String_Concat(string, name);
+        P3DS_Letters(string, " will join the party\nand "); Pokemon_GetValue(picked, MON_DATA_NICKNAME_STRING, name); String_Concat(string, name);
+        P3DS_Letters(string, " goes to the PC.");
+    }
+
+    printerID = P3DS_BattlePrintString(battleSys, string, BattleSystem_GetTextSpeed(battleSys));
+    String_Free(name);
+    String_Free(string);
+    return printerID;
+}
