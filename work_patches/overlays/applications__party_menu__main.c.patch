+#ifdef SDK_PORT_3DS
+#include "port_wide_layout.h"
+
+// The party across the 3DS remaster's wider upper screen. GabeSud0's reference
+// (2026-10-16) puts everything 32 pixels right, leaving a plain strip on the
+// left. Here (platinum3ds run 85) the two columns of panels (and their
+// sprites) are spread apart instead, 16 pixels each way, so the panels reach
+// toward both edges, with the background's plain left and right columns drawn
+// on beside it and a little more of it between the columns; the background
+// and the message box (BG0) stay where they are. (The first part sets the
+// sprites' own shift to the background's: none.)
+static const short sPartyMenuWideLayout[][8] = {
+    WIDE_OBJS(0, 0, 0, 0, 0),
+    WIDE_FILL(WIDE_BG(3), 0, 192, -32, 0, 0),
+    WIDE_FILL(WIDE_BG(3), 0, 192, 256, 288, 255),
+    WIDE_MOVE(WIDE_BG(1) | WIDE_BG(2), 0, 192, 0, 123, -16),
+    WIDE_MOVE(WIDE_BG(1) | WIDE_BG(2), 0, 192, 123, 256, 16),
+    WIDE_OBJS(0, 192, -128, 123, -16),
+    WIDE_OBJS(0, 192, 123, 384, 16),
+};
+#endif
+
