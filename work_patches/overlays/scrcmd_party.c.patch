+/* hm_free=1 (default off): an HM field move works with no party Pokemon knowing it. Returns the slot of a Pokemon that knows
+   the move, else (hm_free on, move is an HM) the first non-egg slot of a Pokemon that can learn it, else -1. Badges are still checked by the scripts. */
+int P3DS_HMFreeSlot(Party *party, u16 moveID)
+{
+    extern int P3DS_CfgInt(const char *, int);
+    extern void PSPNativeMemLog(const char *, ...);
+    static int hf = -1;
+    int i, n = Party_GetCurrentCount(party);
+
+    if (hf < 0) {
+        hf = P3DS_CfgInt("hm_free", 0) != 0;
+        PSPNativeMemLog("[HM] hm_free=%d (party Pokemon that can learn an HM may use it)", hf);
+    }
+    for (i = 0; i < n; i++) {
+        Pokemon *mon = Party_GetPokemonBySlotIndex(party, i);
+        if (Pokemon_GetValue(mon, MON_DATA_IS_EGG, NULL) != FALSE) {
+            continue;
+        }
+        if (Pokemon_GetValue(mon, MON_DATA_MOVE1, NULL) == moveID || Pokemon_GetValue(mon, MON_DATA_MOVE2, NULL) == moveID
+            || Pokemon_GetValue(mon, MON_DATA_MOVE3, NULL) == moveID || Pokemon_GetValue(mon, MON_DATA_MOVE4, NULL) == moveID) {
+            return i;
+        }
+    }
+    if (hf && Item_IsHMMove(moveID)) {
+        /* only a party Pokemon that CAN learn this HM (the game's own TM/HM compatibility) stands in for one that knows it */
+        int tm = -1, it;
+        for (it = ITEM_TM01; it <= ITEM_HM08; it++) {
+            if (Item_MoveForTMHM(it) == moveID) {
+                tm = it - ITEM_TM01;
+                break;
+            }
+        }
+        if (tm >= 0) {
+            for (i = 0; i < n; i++) {
+                Pokemon *mon = Party_GetPokemonBySlotIndex(party, i);
+                if (Pokemon_GetValue(mon, MON_DATA_IS_EGG, NULL) != FALSE) {
+                    continue;
+                }
+                if (Pokemon_CanLearnTM(mon, (u8)tm)) {
+                    return i;
+                }
+            }
+        }
+    }
+    return -1;
+}
