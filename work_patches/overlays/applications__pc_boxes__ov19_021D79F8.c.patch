+#ifdef SDK_PORT_3DS
+// The boxes on the wider screen (2026-10-16, from a reference drawing of
+// them): the panel of the Pokémon looked at (BG2's left, its sprite in 3D,
+// the sprites under it) at the screen's left edge; the box (its wallpaper,
+// BG3, the boxes sliding past behind the panel's edge as they change; the
+// party's tray, BG2's right; the icons, the hand and the buttons) at the
+// right edge; between them, the wallpaper's edge (its stripes) widened.
+// The panels the game puts across the screen (BG1: the boxes to jump to,
+// an item's description) stay in the middle, their sprites with them.
+static short sBoxWideStripes = -1;
+static enum BoxWidePanel sBoxWidePanel;
+
+static void BoxWide_Apply(void)
+{
+    short layout[][8] = {
+        WIDE_OBJS(0, 0, 0, 0, 0), // (the panel's sprites, below)
+        WIDE_FILL(WIDE_BG(3) | WIDE_SCREEN_COLUMNS, 0, 192, -32, 288, 0),
+        WIDE_MOVE(WIDE_BG(3) | WIDE_SCREEN_COLUMNS, 0, 192, 88, 256, 32),
+        WIDE_MOVE(WIDE_BG(2), 0, 192, 0, 112, -32),
+        WIDE_MOVE(WIDE_BG(2), 0, 192, 112, 256, 32),
+        WIDE_OBJS(-64, 160, -64, 72, -32),
+        WIDE_OBJS(-64, 160, 72, 400, 32),
+        WIDE_OBJS(160, 256, -64, 108, -32),
+        WIDE_OBJS(160, 256, 108, 400, 32),
+        WIDE_SHIFT3D(-32),
+    };
+
+    if (sBoxWideStripes < 0) {
+        return;
+    }
+
+    switch (sBoxWidePanel) {
+    case BOX_WIDE_PANEL_JUMP: // (the boxes to jump to)
+        layout[0][2] = 40;
+        layout[0][3] = 120;
+        layout[0][4] = -64;
+        layout[0][5] = 400;
+        break;
+    case BOX_WIDE_PANEL_ITEM: // (the item's icon, at x 18)
+        layout[0][2] = 136;
+        layout[0][3] = 256;
+        layout[0][4] = 0;
+        layout[0][5] = 21;
+        break;
+    default:
+        break;
+    }
+
+    layout[1][7] = sBoxWideStripes;
+    WIDE_LAYOUT(WIDE_ENGINE_MAIN, layout);
+}
+
+static void BoxWide_SetLayout(UnkStruct_ov19_021D8318 *param0)
+{
+    if (BoxApp_GetBoxMode(param0->unk_58F8) == PC_MODE_COMPARE) {
+        sBoxWideStripes = -1;
+        return;
+    }
+
+    // (the stripes: the left edge of the box's wallpaper, where it is
+    // drawn in BG3's picture)
+    sBoxWideStripes = (short)((param0->unk_01 * 8 + 1) & 511);
+    BoxWide_Apply();
+}
+
+void BoxWide_SetPanel(enum BoxWidePanel panel)
+{
+    sBoxWidePanel = panel;
+    BoxWide_Apply();
+}
