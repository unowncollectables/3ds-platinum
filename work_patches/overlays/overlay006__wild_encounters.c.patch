+/* run 73 wild_vis (visible wild Pokemon, port only, default off): helpers for p3ds_follower.h. Nothing is saved. */
+int P3DS_WildGrassTile(FieldSystem *fieldSystem, int x, int z)
+{
+    u8 tb = TerrainCollisionManager_GetTileBehavior(fieldSystem, x, z);
+    return TileBehavior_HasEncounters(tb) && !TileBehavior_IsSurfable(tb);
+}
+/* species/level from the map's grass table with the game's slot rates (20 20 10 10 10 10 5 5 4 4 1 1), the
+   time-of-day / swarm / dual-slot replacements the game applies too */
+int P3DS_WildPick(FieldSystem *fieldSystem, unsigned r, int *species, int *level)
+{
+    static const u8 kRate[MAX_GRASS_ENCOUNTERS] = { 20, 20, 10, 10, 10, 10, 5, 5, 4, 4, 1, 1 };
+    WildEncounters *ed = MapHeaderData_GetWildEncounters(fieldSystem);
+    if (!ed || !ed->grassEncounters.encounterRate) return 0;
+    EncounterSlot tb[MAX_GRASS_ENCOUNTERS];
+    for (int i = 0; i < MAX_GRASS_ENCOUNTERS; i++) { tb[i].species = ed->grassEncounters.encounters[i].species; tb[i].maxLevel = tb[i].minLevel = ed->grassEncounters.encounters[i].level; }
+    BOOL nd = Pokedex_IsNationalDexObtained(SaveData_GetPokedex(FieldSystem_GetSaveData(fieldSystem)));
+    WildEncounters_ReplaceTimedEncounters(ed, &tb[2].species, &tb[3].species);
+    WildEncounters_ReplaceSwarmEncounters(fieldSystem, ed, &tb[0].species, &tb[1].species);
+    WildEncounters_ReplaceDualSlotEncounters(ed, nd, &tb[8].species, &tb[9].species);
+    unsigned v = r % 100, acc = 0; int k = 0;
+    for (k = 0; k < MAX_GRASS_ENCOUNTERS - 1; k++) { acc += kRate[k]; if (v < acc) break; }
+    if (!tb[k].species) return 0;
+    *species = tb[k].species; *level = tb[k].maxLevel; return 1;
+}
+/* the dbg_wild_double recipe, single battle with exactly that species and level; repel / cheat_no_encounters respected */
+int P3DS_WildBattle(FieldSystem *fieldSystem, int species, int level)
+{
+    extern int P3DS_CheatNoEncCfg(void); if (P3DS_CheatNoEncCfg()) return 0;
+    Party *pt = SaveData_GetParty(fieldSystem->saveData); Pokemon *fm = Party_GetPokemonBySlotIndex(pt, 0);
+    WildEncounters_FieldParams fp; EncounterSlot tb[MAX_GRASS_ENCOUNTERS];
+    InitEncounterFieldParams(fieldSystem, fm, MapHeaderData_GetWildEncounters(fieldSystem), &fp);
+    if (!SpecialEncounter_RepelStepsEmpty(SaveData_GetSpecialEncounters(fieldSystem->saveData))) {
+        fp.repelActive = TRUE; fp.firstBattlerLevel = Pokemon_GetValue(Party_FindFirstEligibleBattler(pt), MON_DATA_LEVEL, NULL); }
+    for (int i = 0; i < MAX_GRASS_ENCOUNTERS; i++) { tb[i].species = species; tb[i].maxLevel = tb[i].minLevel = level; }
+    FieldBattleDTO *d = FieldBattleDTO_New(HEAP_ID_FIELD2, BATTLE_TYPE_WILD_MON); FieldBattleDTO_Init(d, fieldSystem);
+    if (TryGenerateWildMon(fm, 0xff, &fp, tb, ENCOUNTER_TYPE_GRASS, 1, d)) { Encounter_NewVsWild(fieldSystem, d); return 1; }
+    FieldBattleDTO_Free(d); return 0;
+}
