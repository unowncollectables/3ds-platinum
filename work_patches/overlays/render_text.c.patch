+int P3DS_CfgInt(const char *, int);
 static BOOL TextPrinter_Continue(TextPrinter *printer)
 {
+    /* run 80: text_hold_b (B held advances a finished text box) and text_auto (advance after ~1.5 s). Only this
+       "waiting on a text box" path; yes/no and menus are separate and never auto-picked. Off = unchanged. */
+    static int p3dsWait;
+    if ((JOY_HELD(PAD_BUTTON_B) && P3DS_CfgInt("text_hold_b", 0)) || (P3DS_CfgInt("text_auto", 0) && ++p3dsWait >= 45)) {
+        p3dsWait = 0;
+        Sound_PlayEffect(SE_CONFIRM_sseq_3);
+        sRenderControlFlags.waitBattle = TRUE;
+        return TRUE;
+    }
     if (JOY_NEW(PAD_BUTTON_A | PAD_BUTTON_B)
         || (gSystem.touchPressed && sRenderControlFlags.speedUpOnTouch)) {
         Sound_PlayEffect(SE_CONFIRM_sseq_3);
         sRenderControlFlags.waitBattle = TRUE;
+        p3dsWait = 0;
         return TRUE;
     }
 
